{
  "name": "ContentPlay",
  "version": "1.3.0",
  "identifier": "com.arnav.contentplay",
  "ghRepo": "Arnav12S/iina-contentplay",
  "ghVersion": 5,
  "author": {
    "name": "Arnav",
    "email": "arnav.sudhansh12@gmail.com"
  },
  "description": "Search movies or series, resolve streams via Stremio (Cinemeta + Torrentio) and your debrid service (Real-Debrid, TorBox, AllDebrid, Premiumize, Debrid-Link, Offcloud, EasyDebrid or Put.io), then open them as an M3U playlist in IINA so the whole season plays with native next-episode.",
  "entry": "index.js",
  "globalEntry": "global.js",
  "sidebarTab": {
    "name": "ContentPlay"
  },
  "permissions": [
    "network-request",
    "show-osd",
    "show-alert",
    "file-system",
    "video-overlay"
  ],
  "allowedDomains": [
    "*"
  ],
  "preferencesPage": "ui/prefs.html",
  "preferenceDefaults": {
    "debridProvider": "realdebrid",
    "debridApiKey": "",
    "rdApiKey": "",
    "torrentioOptions": "sort=qualitysize|qualityfilter=cam,scr,unknown",
    "preferredQuality": "720p",
    "understoodLangs": "en,hi,te",
    "audioPriority": "orig,te,en",
    "subtitleLangs": "en",
    "discoverLang": "",
    "tmdbApiKey": "",
    "avoid3D": true,
    "avoidHDR": true,
    "maxAlternates": "6",
    "concurrency": "6",
    "cinemetaUrl": "https://v3-cinemeta.strem.io",
    "torrentioUrl": "https://torrentio.strem.fun",
    "opensubtitlesUrl": "https://opensubtitles-v3.strem.io",
    "kbOpenPanel": "Ctrl+Alt+Meta+f",
    "kbClosePanel": "Ctrl+Alt+Meta+w",
    "kbNextStream": "",
    "kbPrevStream": "",
    "skipEnabled": true,
    "autoSkipIntroSecs": "5",
    "autoPlayNext": true,
    "nextUpCountdownSecs": "8",
    "recent": "",
    "langByPlaylist": "",
    "streamsByPlaylist": "",
    "lastLang": ""
  }
}
